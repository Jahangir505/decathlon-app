NODE_ENV=development
PORT=8080

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopify_decathlon?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Shopify ---
# From your Partner Dashboard app (shopify.app.toml client_id must match)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated scopes, must match shopify.app.toml
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,read_fulfillments
# Public URL this app is served at (ngrok/cloudflare tunnel in dev, real domain in prod)
SHOPIFY_APP_URL=https://localhost:8080
SHOPIFY_API_VERSION=2025-01

# --- Decathlon Partner (Mirakl) ---
# Base URL differs per environment - see docs/api-mapping.md:
#   Production: https://marketplace-decathlon-eu.mirakl.net/
#   Preprod:    https://decathlonbelgium-preprod.mirakl.net/
DECATHLON_API_BASE_URL=https://decathlonbelgium-preprod.mirakl.net/
DECATHLON_API_VERSION=v1

# --- Security ---
# 32-byte hex/base64 key used for AES-256-GCM encryption of stored credentials
ENCRYPTION_KEY=

# --- Frontend (Vite) ---
VITE_SHOPIFY_API_KEY=
